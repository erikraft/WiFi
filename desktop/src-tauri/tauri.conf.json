{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ErikrafT Wi-Fi",
  "version": "0.1.0",
  "identifier": "com.erikraft.wifi.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ErikrafT Wi-Fi™",
        "width": 1040,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Experimental local network device discovery",
    "longDescription": "ErikrafT Wi-Fi desktop prototype for discovering compatible nodes on a local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
